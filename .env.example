# Ollama API provider settings
# Copy this file to .env and adjust as needed, or set these as system
# environment variables. All have sensible defaults for local Ollama.

# Base URL of the running Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Relative API path for chat completions
OLLAMA_CHAT_PATH=/api/chat

# Model served by Ollama (must be pulled first, e.g. `ollama pull qwen3`)
OLLAMA_MODEL=qwen3

# Request timeout in seconds
OLLAMA_TIMEOUT=300

# Set to 0 to disable token streaming
OLLAMA_STREAM=1